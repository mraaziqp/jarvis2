# Jarvis Environment Configuration
NODE_ENV=development
PORT=3000

# PostgreSQL with pgvector extension
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jarvis_brain

# System Commands Whitelist (comma-separated verbs allowed without prompt)
JARVIS_ALLOWED_COMMANDS=lock,screenshot,play/pause,next,mute,dir,git status

# Local Mail Sentry (Optional - falls back to simulated audit logger if blank)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Jarvis Sentry" <jarvis@assistant.local>

# LLM Providers (for Hosted Model capability)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
JARVIS_GITHUB_TOKEN=
